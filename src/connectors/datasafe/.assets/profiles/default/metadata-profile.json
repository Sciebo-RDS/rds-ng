{
    "metadata": {
        "id": [
            "datasafe",
            "2025.11.26"
        ],
        "displayLabel": "datasafe",
        "description": "Metadata for datasafe."
    },
    "layout": [
        {
            "id": "https://datacite-metadata-schema.readthedocs.io/en/4.5/properties/title/",
            "displayLabel": "Title of your dataset",
            "description": "A name or title by which a resource is known. This may be the title of your dataset, the name of a piece of software or an instrument.",
            "input": [
                {
                    "id": "title",
                    "label": "Title",
                    "type": "string"
                }
            ],
            "required": true,
            "multiple": false
        },
        {
            "id": "resource-type",
            "displayLabel": "Resource type",
            "description": "The type of the resource described by the record.",
            "input": [
                {
                    "id": "resource-type",
                    "label": "Resource type",
                    "type": "dropdown",
                    "options": [
                        "audio",
                        "dataset",
                        "event",
                        "image",
                        "image-diagram",
                        "image-drawing",
                        "image-figure",
                        "image-other",
                        "lesson",
                        "model",
                        "publication-annotationcollection",
                        "publication-article",
                        "publication-book",
                        "publication-conferencepaper",
                        "publication-conferenceproceeding",
                        "publication-datamanagementplan",
                        "publication-datapaper",
                        "publication-dissertation",
                        "publication-journal",
                        "publication-patent",
                        "publication-peerreview",
                        "publication-section",
                        "publication-other",
                        "software-computationalnotebook",
                        "other"
                    ]
                }
            ],
            "required": true,
            "multiple": false
        },
        {
            "id": "invenio-creator",
            "displayLabel": "Creator",
            "description": "The creators field registers those persons or organisations that should be credited for the resource described by the record. The list of persons or organisations in the creators field is used for generating citations, while the persons or organisations listed in the contributors field are not included in the generated citations.",
            "refs": [
                {
                    "classId": "invenio-creator"
                }
            ],
            "required": true,
            "multiple": true
        },
        {
            "id": "publication-date",
            "displayLabel": "Publication date",
            "description": "The date when the resource was or will be made publicly available.",
            "input": [
                {
                    "id": "publication-date",
                    "label": "Publication date",
                    "type": "date"
                }
            ],
            "required": true,
            "multiple": false
        },
        {
            "id": "https://datacite-metadata-schema.readthedocs.io/en/4.5/properties/description/",
            "displayLabel": "Description",
            "description": "All additional information that does not fit in any of the other categories. May be used for technical information or detailed information associated with a scientific instrument.",
            "input": [
                {
                    "id": "abstract",
                    "label": "Description",
                    "type": "textarea"
                }
            ],
            "required": false,
            "multiple": false
        }
    ],
    "classes": {
        "invenio-creator": {
            "id": "invenio-creator",
            "displayLabel": "Creator",
            "description": "The creators field registers those persons or organisations that should be credited for the resource described by the record. The list of persons or organisations in the creators field is used for generating citations, while the persons or organisations listed in the contributors field are not included in the generated citations.",
            "labelTemplate": "${family-name}, ${given-name}",
            "refs": [
                {
                    "classId": "nameIdentifier",
                    "inline": true
                },
                {
                    "classId": "affiliation",
                    "inline": true
                }
            ],
            "input": [
                {
                    "id": "given-name",
                    "label": "Given name",
                    "type": "string",
                    "description": "Given name(s).",
                    "required": true
                },
                {
                    "id": "family-name",
                    "label": "Family name",
                    "type": "string",
                    "description": "Family name.",
                    "required": true
                }
            ]
        },
        "nameIdentifier": {
            "id": "https://datacite-metadata-schema.readthedocs.io/en/4.5/properties/creator/#nameidentifier",
            "displayLabel": "Name Identifier",
            "description": "Uniquely identifies an individual or legal entity, according to various schemes.",
            "example": "Jane Doe",
            "labelTemplate": "${nameIdentifier} (${nameIdentifierScheme})",
            "input": [
                {
                    "id": "nameIdentifierScheme",
                    "label": "",
                    "type": "radiobuttons",
                    "options": [
                        "ORCID",
                        "GND",
                        "ISNI",
                        "ROR",
                        "other"
                    ],
                    "description": "",
                    "hints": {
                        "ORCID": {
                            "text": "Open Researcher and Contributor ID.",
                            "link": {
                                "label": "ORCID Search",
                                "url": "https://orcid.org/orcid-search/search"
                            }
                        },
                        "GND": {
                            "text": "Gemeinsame Normdatei Identifier.",
                            "link": {
                                "label": "GND Search",
                                "url": "https://explore.gnd.network/"
                            }
                        },
                        "ISNI": {
                            "text": "International Standard Name Identifier.",
                            "link": {
                                "label": "ISNI Search",
                                "url": "https://isni.org/page/search-database/"
                            }
                        },
                        "ROR": {
                            "text": "Research Organization Registry Identifier.",
                            "link": {
                                "label": "ROR Search",
                                "url": "https://ror.org/search"
                            }
                        }
                    }
                },
                {
                    "id": "nameIdentifier",
                    "label": "Name identifier",
                    "type": "string"
                }
            ]
        },
        "affiliation": {
            "id": "https://datacite-metadata-schema.readthedocs.io/en/4.5/properties/creator/#affiliation",
            "displayLabel": "Affiliation",
            "labelTemplate": "${affiliation}",
            "input": [
                {
                    "id": "affiliationIdentifierScheme",
                    "label": "",
                    "type": "radiobuttons",
                    "options": [
                        "ISNI",
                        "ROR",
                        "other"
                    ],
                    "description": "",
                    "hints": {
                        "ISNI": {
                            "text": "International Standard Name Identifier.",
                            "link": {
                                "label": "ISNI Search",
                                "url": "https://isni.org/page/search-database/"
                            }
                        },
                        "ROR": {
                            "text": "Research Organization Registry Identifier.",
                            "link": {
                                "label": "ROR Search",
                                "url": "https://ror.org/search"
                            }
                        }
                    }
                },
                {
                    "id": "affiliation",
                    "label": "Affiliation",
                    "type": "string",
                    "description": "The organizational or institutional affiliation of the creator."
                },
                {
                    "id": "affiliationIdentifier",
                    "label": "Affiliation identifier",
                    "type": "string",
                    "description": "Uniquely identifies the organizational affiliation of the creator."
                }
            ]
        }
    }
}
