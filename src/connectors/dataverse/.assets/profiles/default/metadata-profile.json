{
    "metadata": {
        "id": ["dataverse", "2025.10.17"],
        "displayLabel": "Dataverse",
        "description": "A profile for the Dataverse connector."
    },
    "layout": [
        {
            "id": "https://datacite-metadata-schema.readthedocs.io/en/4.5/properties/title/",
            "displayLabel": "Title of your dataset",
            "description": "A name or title by which a resource is known. This may be the title of your dataset, the name of a piece of software or an instrument.",
            "input": [{ "id": "title", "label": "Title", "type": "string" }],
            "required": true,
            "multiple": true
        },
        {
            "id": "dataverseAuthor",
            "displayLabel": "Author",
            "description": "The entity, e.g. a person or organization, that created the Dataset.",
            "refs": [
                {
                    "classId": "dataverseAuthor"
                }
            ],
            "required": true,
            "multiple": true
        },
        {
            "id": "dataversePOC",
            "displayLabel": "Point of Contact",
            "description": "The entity, e.g. a person or organization, that users of the Dataset can contact with questions.",
            "refs": [
                {
                    "classId": "dataversePOC"
                }
            ],
            "required": true,
            "multiple": true
        },
        {
            "id": "https://datacite-metadata-schema.readthedocs.io/en/4.5/properties/description/",
            "displayLabel": "Description (Abstract)",
            "description": "All additional information that does not fit in any of the other categories. May be used for technical information or detailed information associated with a scientific instrument.",
            "input": [
                {
                    "id": "abstract",
                    "label": "Description (Abstract)",
                    "type": "textarea"
                }
            ],
            "required": true,
            "multiple": true
        },
        {
            "id": "dataverseSubject",
            "displayLabel": "Dataverse Subject",
            "input": [
                {
                    "id": "dSubject",
                    "label": "Dataverse Subject",
                    "type": "multiselect",
                    "options": [
                        "Agricultural Sciences",
                        "Arts and Humanities",
                        "Astronomy and Astrophysics",
                        "Business and Management",
                        "Chemistry",
                        "Computer and Information Science",
                        "Earth and Environmental Sciences",
                        "Engineering",
                        "Law",
                        "Mathematical Sciences",
                        "Medicine, Health and Life Sciences",
                        "Physics",
                        "Social Sciences",
                        "Other",
                        "Demo Only"
                    ]
                }
            ],
            "description": "The area of study relevant to the Dataset.",
            "required": true,
            "multiple": true
        },
        {
            "id": "https://datacite-metadata-schema.readthedocs.io/en/4.5/properties/rights/",
            "displayLabel": "Rights",
            "description": "Rights information for the resource.",
            "refs": [
                {
                    "classId": "rights"
                }
            ],
            "required": false,
            "multiple": false
        }
    ],
    "classes": {
        "dataverseAuthor": {
            "id": "dataverseAuthor",
            "displayLabel": "Author",
            "description": "The entity, e.g. a person or organization, that created the Dataset.",
            "labelTemplate": "${name}",
            "input": [
                {
                    "id": "name",
                    "label": "Name",
                    "type": "string",
                    "description": "The name of the author, such as the person's name or the name of an (3 or more characters).",
                    "required": true
                },
                {
                    "id": "affiliation",
                    "label": "Affiliation",
                    "type": "string",
                    "description": "The name of the entity affiliated with the author, e.g. an organization's name (3 or more characters).",
                    "required": false
                }
            ]
        },
        "dataversePOC": {
            "id": "dataversePOC",
            "displayLabel": "Point of Contact",
            "description": "The entity, e.g. a person or organization, that users of the Dataset can contact with questions.",
            "labelTemplate": "${email}",
            "input": [
                {
                    "id": "name",
                    "label": "Name",
                    "type": "string",
                    "description": "The name of the point of contact, e.g. the person's name or the name of an organization (3 or more characters).",
                    "required": false
                },
                {
                    "id": "affiliation",
                    "label": "Affiliation",
                    "type": "string",
                    "description": "The name of the entity affiliated with the point of contact, e.g. an organization's name (3 or more characters).",
                    "required": false
                },
                {
                    "id": "email",
                    "label": "E-Mail",
                    "type": "string",
                    "description": "The point of contact's email address.",
                    "required": true
                }
            ]
        },
        "rights": {
            "id": "https://datacite-metadata-schema.readthedocs.io/en/4.5/properties/rights",
            "displayLabel": "Rights",
            "description": "Rights information for the resource.",
            "example": "Creative Commons Attribution 4.0 International; Apache License, Version 2.0",
            "labelTemplate": "${rights}",
            "input": [
                {
                    "id": "rights",
                    "label": "Rights",
                    "type": "string"
                },
                {
                    "id": "rightsURI",
                    "label": "Rights URI",
                    "type": "string",
                    "description": "The URI of the license.",
                    "example": "https://creativecommons.org/licenses/by/4.0/"
                },
                {
                    "id": "rightsIdentifier",
                    "label": "Rights Identifier",
                    "type": "string",
                    "description": "A short, standardized version of the license name.",
                    "example": "CC-BY-3.0"
                },
                {
                    "id": "rightsIdentifierScheme",
                    "label": "Rights Identifier Scheme",
                    "type": "string",
                    "description": "The name of the scheme.",
                    "example": "SPDX"
                },
                {
                    "id": "schemeURI",
                    "label": "Rights Scheme URI",
                    "type": "string",
                    "description": "The URI of the rights identifier scheme.",
                    "example": "https://spdx.org/licenses/"
                }
            ]
        }
    }
}
